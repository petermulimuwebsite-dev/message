<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peter Milimo — Ministry & Leadership Platform</title>
  <meta name="description" content="Transforming lives through biblical truth, strong marriages, and practical empowerment. Peter Milimo Ministry — petermilimo.org" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ============================================================
       DESIGN TOKENS
    ============================================================ */
    :root {
      /* Brand colours */
      --navy:          #1c2850;
      --navy-mid:      #243068;
      --gold:          #b8842a;
      --gold-lt:       #d4a44c;
      --gold-pale:     #f5e4b8;

      /* Warm section backgrounds — never harsh, never cold */
      --bg-hero:       #1c2850;        /* hero stays deep navy */
      --bg-cream:      #fefcf7;        /* ministry intro */
      --bg-parchment:  #faf6ee;        /* sermons */
      --bg-white:      #ffffff;        /* youtube / books */
      --bg-linen:      #f6f1e7;        /* resources */
      --bg-blush:      #fdf8f2;        /* donate */
      --bg-warm-mist:  #f4f7fb;        /* contact bar */
      --bg-navy:       #1c2850;        /* about stats */

      /* Text */
      --text-dark:     #181c2c;
      --text-mid:      #2d3660;
      --text-body:     #4a556e;
      --text-dim:      #8a96b0;

      /* Cards */
      --card-bg:       #ffffff;
      --card-border:   #ece7db;
      --gold-border:   rgba(184,132,42,0.2);

      /* Shadows */
      --shadow-sm:     0 2px 12px rgba(50,40,20,0.07);
      --shadow-md:     0 8px 32px rgba(50,40,20,0.10);
      --shadow-lg:     0 20px 60px rgba(50,40,20,0.13);
      --shadow-gold:   0 8px 30px rgba(184,132,42,0.18);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Lato', sans-serif;
      background: var(--bg-cream);
      color: var(--text-body);
      overflow-x: hidden;
    }

    /* ============================================================
       NAVIGATION
    ============================================================ */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 20px 60px;
      display: flex; align-items: center; justify-content: space-between;
      transition: background 0.4s, padding 0.4s, box-shadow 0.4s;
    }
    nav.scrolled {
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      padding: 13px 60px;
      box-shadow: 0 2px 24px rgba(50,40,20,0.09);
      border-bottom: 1px solid var(--card-border);
    }

    .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .logo-mark { width: 40px; height: 40px; flex-shrink: 0; }
    .logo-mark svg { width: 100%; height: 100%; }
    .logo-text { display: flex; flex-direction: column; line-height: 1; }
    .logo-name {
      font-family: 'Cinzel', serif; font-size: 13px; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: #fff; transition: color 0.4s;
    }
    .logo-sub {
      font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 300;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.6); margin-top: 3px; transition: color 0.4s;
    }
    nav.scrolled .logo-name { color: var(--navy); }
    nav.scrolled .logo-sub  { color: var(--text-dim); }

    .nav-links { display: flex; align-items: center; gap: 30px; list-style: none; }
    .nav-links a {
      font-family: 'Cinzel', serif; font-size: 10.5px; font-weight: 400;
      letter-spacing: 0.13em; text-transform: uppercase;
      color: rgba(255,255,255,0.82); text-decoration: none; transition: color 0.3s;
      position: relative;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
      height: 1px; background: var(--gold-lt);
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s;
    }
    .nav-links a:hover::after { transform: scaleX(1); }
    nav.scrolled .nav-links a { color: var(--text-mid); }
    nav.scrolled .nav-links a:hover { color: var(--gold); }

    .nav-cta {
      font-family: 'Cinzel', serif; font-size: 10.5px; letter-spacing: 0.13em;
      text-transform: uppercase; font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: #fff !important; padding: 10px 22px; border-radius: 3px;
      text-decoration: none; box-shadow: var(--shadow-gold);
      transition: opacity 0.3s, transform 0.3s !important;
    }
    .nav-cta::after { display: none !important; }
    .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); }

    /* Hamburger — show at 1100px so nav doesn't squeeze */
    .hamburger {
      display: none; flex-direction: column; justify-content: center; gap: 5px;
      cursor: pointer; background: none;
      border: 1px solid rgba(255,255,255,0.3); border-radius: 4px;
      padding: 9px 11px; width: 44px; height: 38px;
      position: relative; z-index: 200; transition: border-color 0.3s;
      flex-shrink: 0;
    }
    nav.scrolled .hamburger { border-color: var(--card-border); }
    .hamburger:hover { border-color: var(--gold-lt); }
    .hamburger span {
      display: block; width: 22px; height: 2px; border-radius: 2px;
      background: #fff; transition: transform 0.35s, opacity 0.25s, background 0.4s;
      transform-origin: center;
    }
    nav.scrolled .hamburger span { background: var(--navy); }
    .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* ============================================================
       MOBILE MENU
    ============================================================ */
    .mm-backdrop {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 140;
      background: rgba(10,16,40,0.65);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }
    .mm-backdrop.open { display: block; }

    .mobile-menu {
      position: fixed;
      top: 0; right: 0;
      width: 290px;
      height: 100%;
      background: #1c2850;
      z-index: 150;
      display: flex;
      flex-direction: column;
      box-shadow: -6px 0 40px rgba(0,0,0,0.4);
      transform: translateX(100%);
      transition: transform 0.32s ease;
    }
    .mobile-menu.open { transform: translateX(0); }

    .mm-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 20px 18px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background: #1c2850;
      flex-shrink: 0;
    }
    .mm-brand {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #d4a44c;
    }
    .mm-close {
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 6px;
      color: rgba(255,255,255,0.8);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .mm-close:hover { background: rgba(212,164,76,0.2); border-color: #d4a44c; color: #d4a44c; }
    .mm-close svg { width: 14px; height: 14px; }

    .mm-nav {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding-top: 100px;
    }
    .mm-nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 17px 20px;
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .mm-nav a::after {
      content: '›';
      font-size: 18px;
      color: rgba(255,255,255,0.3);
    }
    .mm-nav a:hover { background: rgba(255,255,255,0.05); color: #d4a44c; }
    .mm-nav a:hover::after { color: #d4a44c; }
    .mm-nav a.mm-donate {
      color: #d4a44c;
      font-weight: 700;
    }
    .mm-nav a.mm-donate::after { color: #d4a44c; }

    .mm-footer {
      flex-shrink: 0;
      padding: 16px 20px 28px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .mm-footer-note {
      text-align: center;
      font-size: 11px;
      color: rgba(255,255,255,0.3);
    }
    .mm-footer-note a { color: rgba(255,255,255,0.45); text-decoration: underline; }
    .mm-footer-note a:hover { color: #d4a44c; }

    /* ============================================================
       SHARED SECTION HELPERS
    ============================================================ */
    .section-wrap { padding: 100px 60px; max-width: 1280px; margin: 0 auto; }

    .eyebrow {
      font-family: 'Cinzel', serif; font-size: 10px;
      letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold);
      margin-bottom: 14px; display: flex; align-items: center; gap: 14px;
    }
    .eyebrow::before { content: ''; display: block; width: 26px; height: 1px; background: var(--gold); opacity: 0.6; }
    .eyebrow.center { justify-content: center; padding-left: 40px; }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(30px, 4vw, 52px); font-weight: 300;
      color: var(--text-dark); line-height: 1.1; letter-spacing: -0.01em; margin-bottom: 14px;
    }
    .section-title em { font-style: italic; color: var(--gold); }
    .section-title.light { color: #fff; }
    .section-title.light em { color: var(--gold-lt); }

    .section-sub {
      font-size: 16px; font-weight: 300; color: var(--text-body);
      line-height: 1.85; max-width: 520px;
    }

    /* Icon tile — uniform navy square, gold SVG — used everywhere */
    .icon-tile {
      width: 48px; height: 48px; border-radius: 10px; background: var(--navy);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .icon-tile svg { width: 22px; height: 22px; stroke: var(--gold-lt); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

    /* Buttons */
    .btn-primary {
      font-family: 'Cinzel', serif; font-size: 11.5px; letter-spacing: 0.13em;
      text-transform: uppercase; font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: #fff; padding: 15px 36px; border-radius: 3px;
      text-decoration: none; border: none; cursor: pointer;
      box-shadow: var(--shadow-gold); position: relative; overflow: hidden;
      display: inline-block; transition: all 0.35s;
    }
    .btn-primary::before { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0.14); transform: translateX(-100%); transition: transform 0.4s; }
    .btn-primary:hover::before { transform: translateX(100%); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(184,132,42,0.4); }

    .btn-outline {
      font-family: 'Cinzel', serif; font-size: 11.5px; letter-spacing: 0.13em;
      text-transform: uppercase; font-weight: 400;
      color: rgba(255,255,255,0.85); padding: 14px 36px; border-radius: 3px;
      text-decoration: none; border: 1px solid rgba(255,255,255,0.3);
      cursor: pointer; background: transparent; transition: all 0.3s; display: inline-block;
    }
    .btn-outline:hover { border-color: var(--gold-lt); color: var(--gold-lt); transform: translateY(-2px); }

    .btn-ghost {
      font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 0.12em;
      text-transform: uppercase; font-weight: 400;
      color: var(--text-mid); padding: 12px 24px; border-radius: 3px;
      text-decoration: none; border: 1px solid var(--card-border);
      cursor: pointer; background: transparent; transition: all 0.3s; display: inline-block;
    }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

    /* ============================================================
       HERO
    ============================================================ */
    #hero {
      position: relative; min-height: 100vh;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(212,164,76,0.13) 0%, transparent 60%),
        radial-gradient(ellipse 50% 60% at 80% 80%, rgba(36,48,104,0.45) 0%, transparent 60%),
        linear-gradient(160deg, #0e1630 0%, #1c2850 35%, #243068 70%, #1a2248 100%);
    }
    .light-rays { position: absolute; inset: 0; pointer-events: none; }
    .light-ray { position: absolute; top: -10%; width: 2px; height: 130%; transform-origin: top center; border-radius: 2px; background: linear-gradient(180deg, rgba(212,164,76,0.22) 0%, rgba(212,164,76,0.04) 50%, transparent 100%); }
    .light-ray:nth-child(1) { left: 28%; transform: rotate(-10deg); opacity: 0.5; }
    .light-ray:nth-child(2) { left: 40%; transform: rotate(-4deg); opacity: 0.35; width: 3px; }
    .light-ray:nth-child(3) { left: 50%; width: 4px; opacity: 0.6; }
    .light-ray:nth-child(4) { left: 62%; transform: rotate(4deg); opacity: 0.35; width: 3px; }
    .light-ray:nth-child(5) { left: 74%; transform: rotate(10deg); opacity: 0.5; }
    .orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); }
    .orb-1 { width: 500px; height: 500px; top: -100px; left: 50%; transform: translateX(-50%); background: radial-gradient(circle, rgba(212,164,76,0.1) 0%, transparent 70%); animation: floatOrb 9s ease-in-out infinite; }
    .orb-2 { width: 280px; height: 280px; bottom: 8%; right: 8%; background: radial-gradient(circle, rgba(36,48,120,0.3) 0%, transparent 70%); animation: floatOrb 12s ease-in-out infinite reverse; }
    @keyframes floatOrb { 0%,100% { transform: translateY(0) translateX(-50%); } 50% { transform: translateY(-28px) translateX(-50%); } }
    .hero-cross { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-58%); opacity: 0.028; pointer-events: none; }
    .hero-cross svg { width: 600px; height: 600px; }

    .hero-content { position: relative; z-index: 2; text-align: center; padding: 0 20px; max-width: 900px; }
    .hero-eyebrow {
      font-family: 'Cinzel', serif; font-size: 10.5px; letter-spacing: 0.28em;
      text-transform: uppercase; color: var(--gold-lt); margin-bottom: 22px;
      opacity: 0; animation: fadeUp 1s ease forwards 0.3s;
      display: flex; align-items: center; justify-content: center; gap: 16px;
    }
    .hero-eyebrow::before, .hero-eyebrow::after { content: ''; display: block; width: 34px; height: 1px; background: var(--gold-lt); opacity: 0.5; }
    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(48px, 7.5vw, 96px); font-weight: 300; line-height: 0.95;
      color: #fff; letter-spacing: -0.01em;
      opacity: 0; animation: fadeUp 1.1s ease forwards 0.5s;
    }
    .hero-title em { font-style: italic; color: var(--gold-lt); }
    .hero-title .line2 { display: block; font-weight: 600; letter-spacing: 0.04em; }
    .hero-verse {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(16px, 2.3vw, 21px); font-weight: 300; font-style: italic;
      color: rgba(255,255,255,0.58); margin: 28px auto 10px; max-width: 600px; line-height: 1.75;
      opacity: 0; animation: fadeUp 1.1s ease forwards 0.75s;
    }
    .hero-ref { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.22em; color: var(--gold-lt); opacity: 0; animation: fadeUp 1s ease forwards 0.95s; }
    .hero-actions { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 46px; flex-wrap: wrap; opacity: 0; animation: fadeUp 1s ease forwards 1.15s; }
    .scroll-cue { position: absolute; bottom: 34px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; cursor: pointer; opacity: 0; animation: fadeUp 1s ease forwards 1.5s; }
    .scroll-cue span { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.38); }
    .scroll-line { width: 1px; height: 46px; background: linear-gradient(180deg, var(--gold-lt), transparent); animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: translateY(0); } }

    /* ============================================================
       MINISTRY PILLARS
    ============================================================ */
    .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
    .intro-left .section-sub { max-width: 100%; font-size: 16px; margin-bottom: 16px; }
    .intro-right { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .pillar-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; padding: 26px 20px;
      transition: border-color 0.35s, transform 0.35s, box-shadow 0.35s;
      position: relative; overflow: hidden;
    }
    .pillar-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      transform: scaleX(0); transform-origin: left; transition: transform 0.4s;
    }
    .pillar-card:hover::before { transform: scaleX(1); }
    .pillar-card:hover { border-color: var(--gold-border); transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .pillar-icon-wrap { margin-bottom: 16px; }
    .pillar-title { font-family: 'Cinzel', serif; font-size: 11.5px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--navy); margin-bottom: 8px; line-height: 1.35; }
    .pillar-desc { font-size: 13px; font-weight: 300; color: var(--text-body); line-height: 1.65; }

    /* ============================================================
       SERMONS
    ============================================================ */
    .sermons-header { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 52px; }
    .sermons-list { display: flex; flex-direction: column; gap: 20px; }

    .sermon-card {
      display: grid; grid-template-columns: 230px 1fr;
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; overflow: hidden;
      transition: transform 0.4s, box-shadow 0.4s, border-color 0.4s;
      cursor: pointer; position: relative;
    }
    .sermon-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      transform: scaleX(0); transform-origin: left; transition: transform 0.45s; z-index: 2;
    }
    .sermon-card:hover::before { transform: scaleX(1); }
    .sermon-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--gold-border); }

    .sermon-panel { position: relative; overflow: hidden; min-height: 200px; display: flex; flex-direction: column; justify-content: flex-end; padding: 22px; width: 230px; flex-shrink: 0; }
    .sermon-panel-bg { position: absolute; inset: 0; }
    .spb-1 { background: linear-gradient(140deg, #081532 0%, #102260 55%, #1a3a90 100%); }
    .spb-2 { background: linear-gradient(140deg, #120820 0%, #241040 55%, #3d1a6e 100%); }
    .spb-3 { background: linear-gradient(140deg, #071a10 0%, #0c3020 55%, #144d30 100%); }
    .sermon-cross { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-55%); opacity: 0.07; pointer-events: none; }
    .sermon-waves { position: absolute; bottom: 0; left: 0; right: 0; height: 50px; display: flex; align-items: flex-end; gap: 3px; padding: 0 22px; opacity: 0.2; }
    .sermon-waves span { display: block; flex: 1; border-radius: 2px 2px 0 0; background: var(--gold-lt); }
    .sermon-play { position: relative; z-index: 2; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid rgba(212,164,76,0.55); background: rgba(212,164,76,0.12); display: flex; align-items: center; justify-content: center; transition: all 0.35s; margin-bottom: 12px; flex-shrink: 0; }
    .sermon-card:hover .sermon-play { background: var(--gold-lt); border-color: var(--gold-lt); }
    .sermon-play svg { width: 15px; height: 15px; fill: var(--gold-lt); margin-left: 3px; transition: fill 0.3s; }
    .sermon-card:hover .sermon-play svg { fill: var(--navy); }
    .sermon-tag { position: relative; z-index: 2; font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-lt); opacity: 0.9; }
    .sermon-verse { position: relative; z-index: 2; font-family: 'Cormorant Garamond', serif; font-size: 12.5px; font-style: italic; color: rgba(255,255,255,0.4); line-height: 1.5; margin-top: 7px; max-width: 175px; }

    .sermon-body { padding: 26px; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
    .sermon-date { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.2em; color: var(--gold); text-transform: uppercase; margin-bottom: 9px; }
    .sermon-title { font-family: 'Cormorant Garamond', serif; font-size: 23px; font-weight: 600; color: var(--text-dark); line-height: 1.2; margin-bottom: 8px; }
    .sermon-speaker { font-size: 13px; color: var(--text-dim); font-weight: 300; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .sermon-speaker::before { content: ''; display: inline-block; width: 16px; height: 1px; background: var(--text-dim); opacity: 0.5; flex-shrink: 0; }
    .sermon-excerpt { font-size: 13.5px; font-weight: 300; color: var(--text-body); line-height: 1.75; margin-bottom: 20px; }
    .sermon-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

    .btn-sm { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; padding: 9px 16px; border-radius: 3px; text-decoration: none; cursor: pointer; border: 1px solid; transition: all 0.3s; display: inline-flex; align-items: center; gap: 6px; }
    .btn-sm-gold { background: rgba(184,132,42,0.08); color: var(--gold); border-color: rgba(184,132,42,0.28); }
    .btn-sm-gold:hover { background: rgba(184,132,42,0.16); border-color: var(--gold); }
    .btn-sm-navy { background: rgba(28,40,80,0.07); color: var(--navy); border-color: rgba(28,40,80,0.18); }
    .btn-sm-navy:hover { background: var(--navy); color: #fff; }
    .sermon-dur { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.12em; color: var(--text-dim); margin-left: auto; }

    /* ============================================================
       YOUTUBE
    ============================================================ */
    .yt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }

    .yt-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; overflow: hidden;
      display: flex; flex-direction: column;
      transition: transform 0.4s, box-shadow 0.4s, border-color 0.4s;
    }
    .yt-card::before { content: ''; display: block; height: 3px; background: linear-gradient(90deg, var(--gold), var(--gold-lt)); }
    .yt-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--gold-border); }

    .yt-card-head { padding: 26px 26px 18px; display: flex; align-items: center; gap: 16px; }
    .yt-avatar { width: 58px; height: 58px; border-radius: 50%; background: var(--navy); border: 2px solid var(--gold-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .yt-avatar span { font-family: 'Cinzel', serif; font-size: 15px; font-weight: 700; color: var(--gold-lt); }
    .yt-channel-name { font-family: 'Cormorant Garamond', serif; font-size: 19px; font-weight: 700; color: var(--text-dark); line-height: 1.2; margin-bottom: 3px; }
    .yt-handle { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.12em; color: var(--text-dim); text-transform: uppercase; }

    .yt-desc { padding: 0 26px 18px; font-size: 13.5px; font-weight: 300; color: var(--text-body); line-height: 1.75; flex: 1; }
    .yt-latest-label { margin: 0 26px 10px; font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }

    .yt-video-list { margin: 0 26px 22px; display: flex; flex-direction: column; gap: 8px; }
    .yt-video-row {
      display: flex; align-items: center; gap: 12px; padding: 10px 12px;
      background: var(--bg-parchment); border: 1px solid var(--card-border);
      border-radius: 8px; text-decoration: none;
      transition: background 0.25s, border-color 0.25s;
    }
    .yt-video-row:hover { background: var(--bg-linen); border-color: var(--gold-border); }
    .yt-play-btn { width: 30px; height: 30px; border-radius: 50%; background: var(--navy); border: 1px solid var(--gold-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.25s; }
    .yt-play-btn svg { width: 10px; height: 10px; fill: var(--gold-lt); margin-left: 2px; transition: fill 0.25s; }
    .yt-video-row:hover .yt-play-btn { background: var(--gold); }
    .yt-video-row:hover .yt-play-btn svg { fill: #fff; }
    .yt-video-name { font-size: 13px; color: var(--text-dark); line-height: 1.4; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .yt-card-foot { padding: 16px 26px; border-top: 1px solid var(--card-border); display: flex; gap: 12px; }
    .btn-yt-primary { background: var(--navy); color: #fff; border-color: var(--navy); padding: 10px 18px; }
    .btn-yt-primary:hover { background: var(--navy-mid); border-color: var(--navy-mid); transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .btn-yt-ghost { background: transparent; color: var(--gold); border-color: var(--gold-border); }
    .btn-yt-ghost:hover { border-color: var(--gold); background: rgba(184,132,42,0.06); }

    /* ============================================================
       BOOKS
    ============================================================ */
    .books-header { display: grid; grid-template-columns: 1fr auto; align-items: end; margin-bottom: 52px; gap: 40px; }
    .books-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }

    .book-card { border-radius: 10px; overflow: hidden; background: var(--card-bg); border: 1px solid var(--card-border); display: flex; flex-direction: column; transition: transform 0.45s, box-shadow 0.45s; }
    .book-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }

    .book-cover { position: relative; height: 270px; overflow: hidden; }
    .book-cover-bg { position: absolute; inset: 0; transition: transform 0.55s; will-change: transform; }
    .book-card:hover .book-cover-bg { transform: scale(1.04); }
    .bcb-1 { background: linear-gradient(160deg, #071228 0%, #0f2260 40%, #1a3a90 100%); }
    .bcb-2 { background: linear-gradient(160deg, #160508 0%, #3a1015 40%, #6e2020 100%); }
    .bcb-3 { background: linear-gradient(160deg, #03100a 0%, #0c2e18 40%, #155530 100%); }
    .book-spine { position: absolute; top: 0; left: 0; bottom: 0; width: 5px; }
    .bs-1 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }
    .bs-2 { background: linear-gradient(180deg, #f5e0c0, var(--gold-lt)); }
    .bs-3 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }
    .book-orn-t { position: absolute; left: 18px; right: 18px; top: 18px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,164,76,0.4), transparent); }
    .book-orn-b { position: absolute; left: 18px; right: 18px; bottom: 18px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,164,76,0.4), transparent); }
    .book-cross { position: absolute; top: 22px; right: 22px; opacity: 0.1; }
    .book-price-tag { position: absolute; top: 16px; left: 16px; background: rgba(184,132,42,0.18); border: 1px solid rgba(212,164,76,0.4); border-radius: 3px; padding: 4px 11px; font-family: 'Cormorant Garamond', serif; font-size: 15px; font-weight: 600; color: var(--gold-lt); backdrop-filter: blur(8px); }
    .book-cover-text { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 26px 22px 24px 28px; }
    .book-cat { font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold-lt); margin-bottom: 9px; }
    .book-cover-title { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 700; color: #fff; line-height: 1.15; margin-bottom: 5px; }
    .book-cover-author { font-size: 11.5px; font-weight: 300; color: rgba(255,255,255,0.46); letter-spacing: 0.1em; }
    .book-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
    .book-desc { font-size: 13.5px; color: var(--text-body); line-height: 1.75; font-weight: 300; flex: 1; }
    .book-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .btn-book { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 11px 12px; border-radius: 3px; font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: all 0.3s; border: 1px solid; font-weight: 600; }
    .btn-book-gold { background: linear-gradient(135deg, var(--gold-lt), var(--gold)); color: #fff; border-color: var(--gold); box-shadow: var(--shadow-gold); }
    .btn-book-gold:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-book-ghost { background: transparent; color: var(--text-mid); border-color: var(--card-border); }
    .btn-book-ghost:hover { border-color: var(--gold); color: var(--gold); }

    /* ============================================================
       RESOURCES (PDF)
    ============================================================ */
    .resources-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }

    .res-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; padding: 26px 22px;
      display: flex; flex-direction: column; gap: 12px;
      position: relative; overflow: hidden;
      transition: transform 0.35s, box-shadow 0.35s, border-color 0.35s;
    }
    .res-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--gold), var(--gold-lt)); transform: scaleX(0); transform-origin: left; transition: transform 0.4s; }
    .res-card:hover::before { transform: scaleX(1); }
    .res-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--gold-border); }

    .res-icon-wrap { width: 50px; height: 50px; border-radius: 10px; background: linear-gradient(135deg, var(--gold-pale), #eece7a); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .res-icon-wrap svg { width: 24px; height: 24px; stroke: var(--gold); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .res-tag { font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
    .res-title { font-family: 'Cormorant Garamond', serif; font-size: 19px; font-weight: 600; color: var(--text-dark); line-height: 1.25; }
    .res-desc { font-size: 13px; color: var(--text-body); font-weight: 300; line-height: 1.72; flex: 1; }
    .res-meta { font-size: 11.5px; color: var(--text-dim); display: flex; gap: 14px; }
    .btn-dl { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 16px; border-radius: 6px; background: rgba(184,132,42,0.08); border: 1px solid rgba(184,132,42,0.25); color: var(--gold); font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.3s; }
    .btn-dl:hover { background: var(--gold); color: #fff; border-color: var(--gold); }

    /* ============================================================
       DONATE / PAYMENT
    ============================================================ */
    .pay-inner { max-width: 880px; margin: 0 auto; text-align: center; }
    .pay-tabs { display: flex; justify-content: center; gap: 8px; margin: 34px 0 42px; flex-wrap: wrap; }
    .tab-btn { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.13em; text-transform: uppercase; padding: 10px 22px; border-radius: 30px; border: 1px solid var(--card-border); background: var(--card-bg); color: var(--text-body); cursor: pointer; transition: all 0.3s; }
    .tab-btn:hover, .tab-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
    .pay-panel { display: none; text-align: left; }
    .pay-panel.active { display: block; }
    .pay-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start; }

    .pay-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.3s; }
    .pay-card:hover { box-shadow: var(--shadow-md); }
    .pay-card-head { padding: 22px 22px 16px; border-bottom: 1px solid var(--card-border); }
    .pay-card-title { font-family: 'Cinzel', serif; font-size: 13px; font-weight: 600; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 5px; }
    .pay-card-sub { font-size: 13px; font-weight: 300; color: var(--text-dim); line-height: 1.6; }
    .pay-badges { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
    .pay-badge { padding: 3px 9px; border-radius: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; border: 1px solid; }
    .pb-mpesa  { background: #e8f7ef; color: #00a550; border-color: #b3e5cc; }
    .pb-airtel { background: #fdecea; color: #e4002b; border-color: #f5b8c0; }
    .pb-visa   { background: #eef0f9; color: #1a1f71; border-color: #c0c5e8; }
    .pb-mc     { background: #fff5ec; color: #eb6100; border-color: #f5cfb0; }

    .pay-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 11px; }
    .pay-label { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 4px; display: block; }
    .pay-field { display: flex; flex-direction: column; }
    .pay-input { width: 100%; padding: 11px 15px; border-radius: 7px; border: 1px solid var(--card-border); background: var(--bg-parchment); font-family: 'Lato', sans-serif; font-size: 14.5px; color: var(--text-dark); outline: none; transition: border-color 0.3s, background 0.3s; }
    .pay-input:focus { border-color: var(--gold); background: #fff; }
    .pay-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .amt-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .amt-btn { font-family: 'Cinzel', serif; font-size: 11px; font-weight: 600; padding: 8px 15px; border-radius: 6px; border: 1px solid var(--card-border); background: var(--card-bg); color: var(--text-mid); cursor: pointer; transition: all 0.25s; letter-spacing: 0.04em; }
    .amt-btn:hover, .amt-btn.selected { background: var(--navy); color: #fff; border-color: var(--navy); }
    .pay-submit { width: 100%; padding: 13px; border-radius: 7px; background: linear-gradient(135deg, var(--gold-lt), var(--gold)); color: #fff; font-family: 'Cinzel', serif; font-size: 11.5px; letter-spacing: 0.13em; text-transform: uppercase; font-weight: 600; border: none; cursor: pointer; box-shadow: var(--shadow-gold); transition: all 0.3s; margin-top: 3px; }
    .pay-submit:hover { opacity: 0.88; transform: translateY(-1px); }
    .pay-submit-pp { background: linear-gradient(135deg, #009cde, #003087); box-shadow: 0 8px 24px rgba(0,48,135,0.22); }
    .pay-secure { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text-dim); padding-top: 3px; }
    .pay-notice { background: var(--bg-parchment); border: 1px solid var(--card-border); border-left: 3px solid var(--gold); border-radius: 6px; padding: 11px 14px; font-size: 12.5px; font-weight: 300; color: var(--text-body); line-height: 1.65; }
    .pp-or { display: flex; align-items: center; gap: 10px; font-size: 11.5px; color: var(--text-dim); }
    .pp-or::before, .pp-or::after { content: ''; flex: 1; height: 1px; background: var(--card-border); }

    /* ============================================================
       ABOUT STATS (navy band)
    ============================================================ */
    .verse-block { max-width: 760px; margin: 0 auto; text-align: center; margin-bottom: 60px; }
    .verse-quote { font-family: 'Cormorant Garamond', serif; font-size: clamp(22px, 3vw, 40px); font-weight: 300; font-style: italic; color: #fff; line-height: 1.55; margin-bottom: 20px; position: relative; }
    .verse-quote::before { content: '\201C'; position: absolute; top: -28px; left: 50%; transform: translateX(-50%); font-size: 80px; color: var(--gold-lt); opacity: 0.13; font-family: 'Cormorant Garamond', serif; line-height: 1; }
    .verse-ref { font-family: 'Cinzel', serif; font-size: 10.5px; letter-spacing: 0.2em; color: var(--gold-lt); text-transform: uppercase; }
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; max-width: 820px; margin: 0 auto; }
    .stat-cell { padding: 44px 32px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.07); text-align: center; }
    .stat-num { font-family: 'Cormorant Garamond', serif; font-size: 50px; font-weight: 300; color: var(--gold-lt); line-height: 1; margin-bottom: 7px; }
    .stat-label { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.45); }

    /* ============================================================
       CONTACT BAR
    ============================================================ */
    .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; max-width: 820px; margin: 0 auto; }
    .contact-tile {
      display: flex; flex-direction: column; align-items: center; gap: 11px;
      padding: 28px 20px; background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; text-decoration: none; text-align: center;
      transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    }
    .contact-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--gold-border); }
    .contact-label { font-family: 'Cinzel', serif; font-size: 10.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dark); }
    .contact-detail { font-size: 12px; color: var(--text-dim); font-weight: 300; }

    /* ============================================================
       FOOTER
    ============================================================ */
    footer { background: var(--navy); border-top: 1px solid rgba(255,255,255,0.06); padding: 60px 60px 34px; }
    .footer-inner { max-width: 1280px; margin: 0 auto; }
    .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
    .footer-brand-text { font-size: 13.5px; font-weight: 300; color: rgba(255,255,255,0.4); line-height: 1.8; margin-top: 16px; max-width: 250px; }
    .footer-col-title { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-lt); margin-bottom: 16px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .footer-col ul a { font-size: 13.5px; font-weight: 300; color: rgba(255,255,255,0.4); text-decoration: none; transition: color 0.3s; }
    .footer-col ul a:hover { color: var(--gold-lt); }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.06); }
    .footer-copy { font-size: 11.5px; color: rgba(255,255,255,0.27); font-weight: 300; }
    .footer-socials { display: flex; gap: 12px; }
    .footer-socials a { width: 32px; height: 32px; border-radius: 3px; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.38); text-decoration: none; transition: all 0.3s; }
    .footer-socials a:hover { border-color: var(--gold-lt); color: var(--gold-lt); }

    /* ============================================================
       SCROLL REVEAL
    ============================================================ */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .d1 { transition-delay: 0.10s; }
    .d2 { transition-delay: 0.20s; }
    .d3 { transition-delay: 0.30s; }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @media (max-width: 1100px) {
      nav, nav.scrolled { padding-left: 24px; padding-right: 24px; }
      .nav-links { display: none; }
      .hamburger { display: flex; }
    }
    @media (max-width: 1024px) {
      .section-wrap { padding: 80px 28px; }
      footer { padding: 50px 28px 28px; }
      .sermons-header { grid-template-columns: 1fr; gap: 18px; margin-bottom: 38px; }
      .books-grid { grid-template-columns: 1fr 1fr; }
      .resources-grid { grid-template-columns: 1fr 1fr; }
      .footer-top { grid-template-columns: 1fr 1fr; gap: 36px; }
    }
    @media (max-width: 768px) {
      .section-wrap { padding: 60px 20px; }
      footer { padding: 42px 20px 22px; }
      nav, nav.scrolled { padding: 14px 20px; }
      .hero-verse { font-size: 15.5px; padding: 0 8px; }
      .hero-actions { flex-direction: column; align-items: center; gap: 12px; }
      .btn-primary, .btn-outline { width: 100%; max-width: 280px; text-align: center; }
      .scroll-cue { display: none; }
      .sermon-card { grid-template-columns: 1fr; }
      .sermon-panel { width: 100%; min-height: 115px; flex-direction: row; align-items: center; gap: 15px; padding: 16px 18px; }
      .sermon-play { margin-bottom: 0; flex-shrink: 0; }
      .sermon-verse, .sermon-cross, .sermon-waves { display: none; }
      .sermon-body { padding: 16px 18px 18px; }
      .sermon-title { font-size: 19px; }
      .sermon-excerpt { font-size: 13px; margin-bottom: 14px; }
      .sermon-dur { display: none; }
      .yt-grid { grid-template-columns: 1fr; }
      .books-grid { grid-template-columns: 1fr; }
      .books-header { grid-template-columns: 1fr; }
      .resources-grid { grid-template-columns: 1fr; }
      .intro-grid { grid-template-columns: 1fr; gap: 38px; }
      .intro-right { grid-template-columns: 1fr 1fr; }
      .stats-grid { grid-template-columns: 1fr; gap: 2px; }
      .contact-grid { grid-template-columns: 1fr; max-width: 380px; }
      .pay-cols { grid-template-columns: 1fr; }
      .footer-top { grid-template-columns: 1fr; gap: 26px; }
      .footer-bottom { flex-direction: column; gap: 14px; text-align: center; }
    }
    @media (max-width: 480px) {
      .intro-right { grid-template-columns: 1fr; }
      .book-btns { grid-template-columns: 1fr; }
      .logo-sub { display: none; }
    }
  </style>
</head>
<body>

  <!-- ── MOBILE MENU ─────────────────────────────── -->
  <div class="mm-backdrop" id="mmBackdrop"></div>
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mm-header">
      <span class="mm-brand">Peter Milimo</span>
      <button class="mm-close" id="mmClose" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
