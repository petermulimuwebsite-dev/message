<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peter Milimo — Ministry & Leadership Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* ============================================
       CSS VARIABLES & RESET
    ============================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:      #0a0f1e;
      --navy-mid:  #111827;
      --navy-soft: #1a2540;
      --gold:      #c9973a;
      --gold-lt:   #e8c07a;
      --gold-pale: #f5e6c8;
      --cream:     #fdf8f0;
      --white:     #ffffff;
      --text-dim:  #9ba8bc;
      --text-body: #d4dde8;
      --glass:     rgba(255,255,255,0.04);
      --glass-border: rgba(201,151,58,0.18);
      --shadow-gold: 0 0 60px rgba(201,151,58,0.12);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Lato', sans-serif;
      background: var(--navy);
      color: var(--text-body);
      overflow-x: hidden;
      cursor: default;
    }

    /* ============================================
       NOISE TEXTURE OVERLAY
    ============================================ */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
      opacity: 0.6;
    }

    /* ============================================
       NAVIGATION
    ============================================ */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 22px 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.5s ease, padding 0.4s ease, backdrop-filter 0.4s ease;
    }

    nav.scrolled {
      background: rgba(10,15,30,0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 14px 60px;
      border-bottom: 1px solid var(--glass-border);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .logo-mark {
      width: 44px;
      height: 44px;
      position: relative;
      flex-shrink: 0;
    }

    .logo-mark svg {
      width: 100%;
      height: 100%;
    }

    .logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .logo-text .church-name {
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: var(--gold-lt);
      text-transform: uppercase;
    }

    .logo-text .church-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.2em;
      color: var(--text-dim);
      text-transform: uppercase;
      margin-top: 3px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 36px;
      list-style: none;
    }

    .nav-links a {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.3s;
      position: relative;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0; right: 0;
      height: 1px;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s ease;
    }

    .nav-links a:hover { color: var(--gold-lt); }
    .nav-links a:hover::after { transform: scaleX(1); }

    .nav-cta {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--navy) !important;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      padding: 10px 22px;
      border-radius: 2px;
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.3s, transform 0.3s !important;
    }

    .nav-cta::after { display: none !important; }
    .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); }

    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: 1px solid rgba(201,151,58,0.22);
      border-radius: 4px;
      padding: 9px 11px;
      width: 44px;
      height: 38px;
      position: relative;
      z-index: 200;
      transition: border-color 0.3s;
    }

    .hamburger:hover { border-color: rgba(201,151,58,0.5); }

    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--gold-lt);
      border-radius: 2px;
      transition: transform 0.35s ease, opacity 0.25s ease;
      transform-origin: center;
    }

    /* Animate to X when menu is open */
    .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* ============================================
       HERO SECTION
    ============================================ */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(201,151,58,0.07) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 20% 50%, rgba(201,151,58,0.04) 0%, transparent 55%),
        radial-gradient(ellipse 50% 60% at 80% 80%, rgba(30,50,120,0.3) 0%, transparent 60%),
        linear-gradient(180deg, #05080f 0%, #0a0f1e 40%, #0d1525 100%);
    }

    /* Stained glass light rays */
    .light-rays {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .light-ray {
      position: absolute;
      top: -10%;
      width: 2px;
      height: 130%;
      background: linear-gradient(180deg, rgba(201,151,58,0.25) 0%, rgba(201,151,58,0.04) 50%, transparent 100%);
      transform-origin: top center;
      border-radius: 2px;
    }

    .light-ray:nth-child(1) { left: 30%; transform: rotate(-8deg); opacity: 0.6; }
    .light-ray:nth-child(2) { left: 40%; transform: rotate(-3deg); opacity: 0.4; width: 3px; }
    .light-ray:nth-child(3) { left: 50%; transform: rotate(0deg);  opacity: 0.7; width: 4px; background: linear-gradient(180deg, rgba(232,192,122,0.35) 0%, rgba(201,151,58,0.06) 50%, transparent 100%); }
    .light-ray:nth-child(4) { left: 60%; transform: rotate(3deg);  opacity: 0.4; width: 3px; }
    .light-ray:nth-child(5) { left: 70%; transform: rotate(8deg);  opacity: 0.6; }

    /* Floating orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(80px);
    }

    .orb-1 {
      width: 500px; height: 500px;
      top: -100px; left: 50%;
      transform: translateX(-50%);
      background: radial-gradient(circle, rgba(201,151,58,0.09) 0%, transparent 70%);
      animation: floatOrb 8s ease-in-out infinite;
    }

    .orb-2 {
      width: 300px; height: 300px;
      bottom: 10%; right: 10%;
      background: radial-gradient(circle, rgba(30,80,200,0.12) 0%, transparent 70%);
      animation: floatOrb 11s ease-in-out infinite reverse;
    }

    .orb-3 {
      width: 250px; height: 250px;
      top: 30%; left: 5%;
      background: radial-gradient(circle, rgba(201,151,58,0.06) 0%, transparent 70%);
      animation: floatOrb 9s ease-in-out infinite 2s;
    }

    @keyframes floatOrb {
      0%, 100% { transform: translateY(0) translateX(-50%); }
      50% { transform: translateY(-30px) translateX(-50%); }
    }

    .orb-2 { animation-name: floatOrbSimple; }
    .orb-3 { animation-name: floatOrbSimple; }

    @keyframes floatOrbSimple {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }

    /* Hero cross decoration */
    .hero-cross {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -58%);
      opacity: 0.025;
      pointer-events: none;
    }

    .hero-cross svg {
      width: 600px;
      height: 600px;
    }

    /* Hero content */
    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 0 20px;
      max-width: 900px;
    }

    .hero-eyebrow {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 28px;
      opacity: 0;
      animation: fadeUp 1s ease forwards 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }

    .hero-eyebrow::before,
    .hero-eyebrow::after {
      content: '';
      display: block;
      width: 40px;
      height: 1px;
      background: var(--gold);
      opacity: 0.5;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(52px, 8vw, 100px);
      font-weight: 300;
      line-height: 0.95;
      color: var(--white);
      letter-spacing: -0.01em;
      opacity: 0;
      animation: fadeUp 1.1s ease forwards 0.55s;
    }

    .hero-title em {
      font-style: italic;
      color: var(--gold-lt);
      font-weight: 300;
    }

    .hero-title .line2 {
      display: block;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .hero-verse {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(18px, 2.5vw, 24px);
      font-weight: 300;
      font-style: italic;
      color: var(--text-dim);
      margin: 32px auto 12px;
      max-width: 620px;
      line-height: 1.7;
      opacity: 0;
      animation: fadeUp 1.1s ease forwards 0.8s;
    }

    .hero-ref {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.2em;
      color: var(--gold);
      opacity: 0;
      animation: fadeUp 1s ease forwards 1s;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-top: 52px;
      flex-wrap: wrap;
      opacity: 0;
      animation: fadeUp 1s ease forwards 1.2s;
    }

    .btn-primary {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--navy);
      padding: 16px 38px;
      border-radius: 2px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.35s ease;
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.15);
      transform: translateX(-100%);
      transition: transform 0.4s ease;
    }

    .btn-primary:hover::before { transform: translateX(100%); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(201,151,58,0.35); }

    .btn-outline {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 400;
      color: var(--gold-lt);
      padding: 15px 38px;
      border-radius: 2px;
      text-decoration: none;
      border: 1px solid rgba(201,151,58,0.35);
      cursor: pointer;
      background: transparent;
      transition: all 0.35s ease;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      background: rgba(201,151,58,0.06);
      transform: translateY(-2px);
    }

    .scroll-indicator {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      opacity: 0;
      animation: fadeUp 1s ease forwards 1.6s;
      cursor: pointer;
    }

    .scroll-indicator span {
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    .scroll-line {
      width: 1px;
      height: 50px;
      background: linear-gradient(180deg, var(--gold) 0%, transparent 100%);
      animation: scrollPulse 2s ease-in-out infinite;
    }

    @keyframes scrollPulse {
      0%, 100% { opacity: 0.3; transform: scaleY(0.8); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================
       SECTION DIVIDER
    ============================================ */
    .divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 0 40px;
      margin-bottom: 70px;
    }

    .divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
    }

    .divider-icon {
      color: var(--gold);
      font-size: 16px;
      opacity: 0.7;
    }

    /* ============================================
       SECTION COMMONS
    ============================================ */
    section {
      padding: 120px 60px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .section-eyebrow {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .section-eyebrow::before {
      content: '';
      display: block;
      width: 30px;
      height: 1px;
      background: var(--gold);
      opacity: 0.6;
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(36px, 4vw, 58px);
      font-weight: 300;
      color: var(--white);
      line-height: 1.1;
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }

    .section-title em {
      font-style: italic;
      color: var(--gold-lt);
    }

    .section-subtitle {
      font-size: 16px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.8;
      max-width: 520px;
    }

    /* ============================================
       INTRO SECTION
    ============================================ */
    #intro {
      padding: 100px 60px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .intro-left .section-subtitle {
      max-width: 100%;
      font-size: 17px;
      line-height: 1.9;
      margin-bottom: 20px;
    }

    .intro-left .section-subtitle + .section-subtitle {
      color: rgba(155,168,188,0.7);
      font-size: 15px;
    }

    .intro-right {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .pillar-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--glass-border);
      border-radius: 6px;
      padding: 28px 22px;
      transition: border-color 0.35s, transform 0.35s;
      position: relative;
      overflow: hidden;
    }

    .pillar-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--gold), transparent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .pillar-card:hover::before { transform: scaleX(1); }
    .pillar-card:hover { border-color: rgba(201,151,58,0.3); transform: translateY(-3px); }

    .pillar-icon {
      font-size: 28px;
      margin-bottom: 14px;
      display: block;
    }

    .pillar-title {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold-lt);
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .pillar-desc {
      font-size: 13px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.65;
    }

    @media (max-width: 900px) {
      #intro { padding: 70px 30px; }
      .intro-grid { grid-template-columns: 1fr; gap: 50px; }
    }
    @media (max-width: 560px) {
      .intro-right { grid-template-columns: 1fr; }
      #intro { padding: 60px 20px; }
    }

    /* ============================================
       ASTRO COMPATIBILITY FIXES
    ============================================ */

    /* Ensure sections don't overflow in Astro's wrapper divs */
    section {
      width: 100%;
      box-sizing: border-box;
    }

    /* Fix sermon card grid collapsing inside Astro containers */
    .sermon-card {
      width: 100%;
      min-width: 0;
    }

    .sermon-panel {
      min-width: 0;
      width: 260px;
      flex-shrink: 0;
    }

    .sermon-body {
      min-width: 0;
      overflow: hidden;
    }

    /* Book cover scale transition — force GPU layer for Astro */
    .book-cover-bg {
      will-change: transform;
      backface-visibility: hidden;
    }

    /* Pillar cards — ensure they don't collapse */
    .intro-right {
      min-width: 0;
    }

    .pillar-card {
      min-width: 0;
      word-wrap: break-word;
    }

    /* Prevent Google Fonts flash in Astro SSR */
    body { font-display: swap; }

    /* Fix stat grid borders collapsing */
    .about-stat {
      border-radius: 0;
    }

    /* ============================================
       SERMONS SECTION
    ============================================ */
    #sermons {
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy-mid) 50%, var(--navy) 100%);
    }

    .sermons-wrapper { max-width: 1280px; margin: 0 auto; }

    .sermons-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: end;
      margin-bottom: 64px;
    }

    .sermons-grid {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* --- Sermon card: horizontal editorial strip --- */
    .sermon-card {
      display: grid;
      grid-template-columns: 260px 1fr;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--glass-border);
      border-radius: 6px;
      overflow: hidden;
      transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
      cursor: pointer;
      position: relative;
    }

    .sermon-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(201,151,58,0.22);
      border-color: rgba(201,151,58,0.3);
    }

    /* Left visual panel */
    .sermon-panel {
      position: relative;
      overflow: hidden;
      min-height: 200px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 24px;
    }

    .sermon-panel-bg {
      position: absolute;
      inset: 0;
    }

    .sermon-panel-bg-1 {
      background: linear-gradient(140deg, #071228 0%, #0e2250 55%, #1a3a80 100%);
    }
    .sermon-panel-bg-2 {
      background: linear-gradient(140deg, #120820 0%, #241040 55%, #3d1a6e 100%);
    }
    .sermon-panel-bg-3 {
      background: linear-gradient(140deg, #071a10 0%, #0c3020 55%, #144d30 100%);
    }

    /* Cross watermark inside panel */
    .sermon-panel-cross {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -52%);
      opacity: 0.06;
      pointer-events: none;
    }

    /* Waveform bars decoration */
    .sermon-waveform {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 56px;
      display: flex;
      align-items: flex-end;
      gap: 3px;
      padding: 0 24px 0 24px;
      opacity: 0.18;
    }

    .sermon-waveform span {
      display: block;
      flex: 1;
      border-radius: 2px 2px 0 0;
      background: var(--gold-lt);
      transition: height 0.3s ease;
    }

    .sermon-card:hover .sermon-waveform span {
      opacity: 0.32;
    }

    /* Gold top accent line */
    .sermon-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt), transparent);
      z-index: 2;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.45s ease;
    }
    .sermon-card:hover::before { transform: scaleX(1); }

    /* Play button */
    .sermon-play {
      position: relative;
      z-index: 2;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 1.5px solid rgba(201,151,58,0.55);
      background: rgba(201,151,58,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.35s;
      margin-bottom: 16px;
      flex-shrink: 0;
    }

    .sermon-card:hover .sermon-play {
      background: var(--gold);
      border-color: var(--gold);
      transform: scale(1.08);
    }

    .sermon-play svg {
      width: 18px; height: 18px;
      fill: var(--gold-lt);
      margin-left: 3px;
      transition: fill 0.3s;
    }

    .sermon-card:hover .sermon-play svg { fill: var(--navy); }

    /* Panel tag */
    .sermon-panel-tag {
      position: relative;
      z-index: 2;
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      opacity: 0.85;
    }

    /* Panel scripture snippet */
    .sermon-panel-verse {
      position: relative;
      z-index: 2;
      font-family: 'Cormorant Garamond', serif;
      font-size: 13px;
      font-style: italic;
      font-weight: 300;
      color: rgba(255,255,255,0.45);
      line-height: 1.5;
      margin-top: 8px;
      max-width: 180px;
    }

    /* Right content area */
    .sermon-body {
      padding: 28px 28px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .sermon-body-top { flex: 1; }

    .sermon-date {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .sermon-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      color: var(--white);
      line-height: 1.2;
      margin-bottom: 10px;
      letter-spacing: -0.01em;
    }

    .sermon-speaker {
      font-size: 13px;
      color: var(--text-dim);
      font-weight: 300;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .sermon-speaker::before {
      content: '';
      display: inline-block;
      width: 20px;
      height: 1px;
      background: var(--text-dim);
      opacity: 0.5;
      flex-shrink: 0;
    }

    .sermon-excerpt {
      font-size: 14px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.75;
      margin-bottom: 24px;
      opacity: 0.8;
    }

    .sermon-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-sm {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      padding: 10px 20px;
      border-radius: 2px;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .btn-sm-gold {
      background: rgba(201,151,58,0.12);
      color: var(--gold-lt);
      border: 1px solid rgba(201,151,58,0.28);
    }
    .btn-sm-gold:hover {
      background: rgba(201,151,58,0.22);
      border-color: var(--gold);
    }

    .btn-sm-wa {
      background: rgba(37,211,102,0.08);
      color: #4fdb80;
      border: 1px solid rgba(37,211,102,0.2);
    }
    .btn-sm-wa:hover {
      background: rgba(37,211,102,0.16);
      border-color: rgba(37,211,102,0.4);
    }

    .sermon-duration {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      opacity: 0.6;
      margin-left: auto;
      align-self: center;
    }

    @media (max-width: 700px) {
      .sermon-card { grid-template-columns: 1fr; }
      .sermon-panel { min-height: 140px; flex-direction: row; align-items: center; gap: 16px; }
      .sermon-panel-verse { display: none; }
    }

    /* ============================================
       BOOKS SECTION
    ============================================ */
    #books { position: relative; }

    #books::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 50% at 50% 50%, rgba(201,151,58,0.04) 0%, transparent 70%);
      pointer-events: none;
    }

    .books-header {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      margin-bottom: 64px;
      gap: 40px;
    }

    .books-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    /* --- Book card: full-bleed cover panel --- */
    .book-card {
      border-radius: 6px;
      overflow: hidden;
      transition: transform 0.45s ease, box-shadow 0.45s ease;
      position: relative;
      display: flex;
      flex-direction: column;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--glass-border);
    }

    .book-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 32px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(201,151,58,0.25);
    }

    /* Full-bleed cover */
    .book-cover {
      position: relative;
      height: 300px;
      overflow: hidden;
    }

    .book-cover-bg {
      position: absolute;
      inset: 0;
      transition: transform 0.55s ease;
    }

    .book-card:hover .book-cover-bg { transform: scale(1.04); }

    .book-cover-bg-1 {
      background: linear-gradient(160deg, #071228 0%, #0f2260 40%, #1a3a90 75%, #c9973a22 100%);
    }
    .book-cover-bg-2 {
      background: linear-gradient(160deg, #160508 0%, #3a1015 40%, #6e2020 75%, #e8c07a22 100%);
    }
    .book-cover-bg-3 {
      background: linear-gradient(160deg, #03100a 0%, #0c2e18 40%, #155530 75%, #c9973a22 100%);
    }

    /* Spine strip on left */
    .book-spine {
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 6px;
    }
    .book-spine-1 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }
    .book-spine-2 { background: linear-gradient(180deg, #f5e6c8, #e8c07a); }
    .book-spine-3 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }

    /* Decorative cross on cover */
    .book-cover-cross {
      position: absolute;
      top: 24px;
      right: 24px;
      opacity: 0.12;
    }

    /* Ornamental lines */
    .book-cover-ornament {
      position: absolute;
      left: 24px; right: 24px;
      top: 24px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(201,151,58,0.4), transparent);
    }

    .book-cover-ornament-b {
      position: absolute;
      left: 24px; right: 24px;
      bottom: 24px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(201,151,58,0.4), transparent);
    }

    /* Cover text content */
    .book-cover-content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 32px 28px 28px 34px;
    }

    .book-cover-category {
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 12px;
    }

    .book-cover-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px;
      font-weight: 700;
      color: var(--white);
      line-height: 1.15;
      letter-spacing: 0.01em;
      margin-bottom: 8px;
    }

    .book-cover-author {
      font-size: 12px;
      font-weight: 300;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.1em;
    }

    /* Price badge floating on cover */
    .book-price-badge {
      position: absolute;
      top: 20px;
      left: 22px;
      background: rgba(201,151,58,0.15);
      border: 1px solid rgba(201,151,58,0.35);
      border-radius: 2px;
      padding: 5px 12px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      font-weight: 600;
      color: var(--gold-lt);
      backdrop-filter: blur(8px);
    }

    /* Card body below cover */
    .book-body {
      padding: 22px 24px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      flex: 1;
    }

    .book-desc {
      font-size: 13.5px;
      color: var(--text-dim);
      line-height: 1.75;
      font-weight: 300;
      flex: 1;
    }

    .book-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .btn-book-wa {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(37,211,102,0.08);
      border: 1px solid rgba(37,211,102,0.22);
      border-radius: 2px;
      color: #4fdb80;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s;
    }
    .btn-book-wa:hover {
      background: rgba(37,211,102,0.16);
      border-color: rgba(37,211,102,0.45);
      transform: translateY(-1px);
    }

    .btn-book-fb {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(24,119,242,0.08);
      border: 1px solid rgba(24,119,242,0.22);
      border-radius: 2px;
      color: #6ba8f7;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s;
    }
    .btn-book-fb:hover {
      background: rgba(24,119,242,0.16);
      border-color: rgba(24,119,242,0.45);
      transform: translateY(-1px);
    }

    @media (max-width: 880px) {
      .books-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .books-grid { grid-template-columns: 1fr; }
      .book-actions { grid-template-columns: 1fr; }
    }

    /* ============================================
       ABOUT / VERSE SECTION
    ============================================ */
    #about {
      position: relative;
      text-align: center;
      padding: 120px 60px;
    }

    .verse-block {
      max-width: 800px;
      margin: 0 auto;
    }

    .verse-quote {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(28px, 3.5vw, 48px);
      font-weight: 300;
      font-style: italic;
      color: var(--white);
      line-height: 1.5;
      margin-bottom: 28px;
      position: relative;
    }

    .verse-quote::before {
      content: '\201C';
      position: absolute;
      top: -30px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 100px;
      color: var(--gold);
      opacity: 0.15;
      font-family: 'Cormorant Garamond', serif;
      line-height: 1;
    }

    .verse-ref {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 64px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      max-width: 900px;
      margin: 0 auto;
    }

    .about-stat {
      padding: 50px 40px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      text-align: center;
    }

    .stat-number {
      font-family: 'Cormorant Garamond', serif;
      font-size: 54px;
      font-weight: 300;
      color: var(--gold-lt);
      line-height: 1;
      margin-bottom: 8px;
    }

    .stat-label {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    /* ============================================
       SOCIAL CONNECT SECTION
    ============================================ */
    #connect {
      padding: 100px 60px;
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy-mid) 100%);
    }

    .connect-inner {
      max-width: 1280px;
      margin: 0 auto;
    }

    .connect-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .connect-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 860px;
      margin: 0 auto;
    }

    .connect-card {
      border-radius: 4px;
      padding: 50px 44px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      text-decoration: none;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .connect-card::before {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .connect-card:hover { transform: translateY(-6px); }
    .connect-card:hover::before { opacity: 1; }

    .connect-card-wa {
      background: linear-gradient(135deg, rgba(18,40,28,0.9), rgba(10,25,18,0.95));
      border: 1px solid rgba(37,211,102,0.2);
    }

    .connect-card-wa::before {
      background: linear-gradient(135deg, rgba(37,211,102,0.06), transparent);
    }

    .connect-card-wa:hover {
      box-shadow: 0 20px 60px rgba(37,211,102,0.12);
      border-color: rgba(37,211,102,0.4);
    }

    .connect-card-fb {
      background: linear-gradient(135deg, rgba(10,20,50,0.9), rgba(8,15,35,0.95));
      border: 1px solid rgba(24,119,242,0.2);
    }

    .connect-card-fb::before {
      background: linear-gradient(135deg, rgba(24,119,242,0.06), transparent);
    }

    .connect-card-fb:hover {
      box-shadow: 0 20px 60px rgba(24,119,242,0.12);
      border-color: rgba(24,119,242,0.4);
    }

    .connect-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }

    .connect-icon-wa { background: rgba(37,211,102,0.12); }
    .connect-icon-fb { background: rgba(24,119,242,0.12); }

    .connect-card-title {
      font-family: 'Cinzel', serif;
      font-size: 18px;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 10px;
    }

    .connect-card-desc {
      font-size: 14px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.7;
      margin-bottom: 32px;
      flex: 1;
    }

    .connect-link-text {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .connect-card-wa .connect-link-text { color: #4fdb80; }
    .connect-card-fb .connect-link-text { color: #6ba8f7; }

    .connect-link-text::after {
      content: '→';
      transition: transform 0.3s;
    }

    .connect-card:hover .connect-link-text::after { transform: translateX(6px); }

    /* ============================================
       FOOTER
    ============================================ */
    footer {
      border-top: 1px solid var(--glass-border);
      padding: 60px 60px 40px;
    }

    .footer-inner {
      max-width: 1280px;
      margin: 0 auto;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 48px;
      margin-bottom: 56px;
    }

    .footer-brand p {
      font-size: 14px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.8;
      margin-top: 20px;
      max-width: 280px;
    }

    .footer-col-title {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 20px;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-col ul a {
      font-size: 14px;
      font-weight: 300;
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.3s;
    }

    .footer-col ul a:hover { color: var(--gold-lt); }

    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 28px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .footer-bottom p {
      font-size: 12px;
      color: var(--text-dim);
      font-weight: 300;
    }

    .footer-social {
      display: flex;
      gap: 16px;
    }

    .footer-social a {
      width: 36px;
      height: 36px;
      border-radius: 2px;
      border: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dim);
      text-decoration: none;
      transition: all 0.3s;
    }

    .footer-social a:hover {
      border-color: var(--gold);
      color: var(--gold-lt);
    }

    /* ============================================
       SCROLL REVEAL
    ============================================ */
    .reveal {
      opacity: 0;
      transform: translateY(36px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }

    /* ============================================
       MOBILE NAV MENU
    ============================================ */
    .mobile-menu {
      position: fixed;
      inset: 0;
      background: rgba(5, 8, 15, 0.97);
      z-index: 150;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-menu.open {
      opacity: 1;
      pointer-events: all;
    }

    /* Faint cross watermark */
    .mobile-menu::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,151,58,0.04) 0%, transparent 70%);
      pointer-events: none;
    }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .mobile-menu-nav a {
      font-family: 'Cinzel', serif;
      font-size: 20px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-dim);
      text-decoration: none;
      padding: 20px 40px;
      width: 100%;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      opacity: 0;
      transform: translateY(14px);
      transition: color 0.3s, background 0.3s, opacity 0.4s ease, transform 0.4s ease;
    }

    .mobile-menu.open .mobile-menu-nav a { opacity: 1; transform: translateY(0); }
    .mobile-menu.open .mobile-menu-nav a:nth-child(1) { transition-delay: 0.04s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(2) { transition-delay: 0.09s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(3) { transition-delay: 0.14s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(4) { transition-delay: 0.19s; }

    .mobile-menu-nav a:hover {
      color: var(--gold-lt);
      background: rgba(201,151,58,0.05);
    }

    .mobile-menu-cta {
      margin-top: 32px;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.4s ease 0.24s, transform 0.4s ease 0.24s;
    }

    .mobile-menu.open .mobile-menu-cta { opacity: 1; transform: translateY(0); }

    .mobile-menu-cta a {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--navy);
      padding: 14px 44px;
      border-radius: 2px;
      text-decoration: none;
      display: inline-block;
    }

    .mobile-menu-socials {
      display: flex;
      gap: 14px;
      margin-top: 32px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s ease 0.3s, transform 0.4s ease 0.3s;
    }

    .mobile-menu.open .mobile-menu-socials { opacity: 1; transform: translateY(0); }

    .mobile-menu-socials a {
      width: 40px;
      height: 40px;
      border-radius: 4px;
      border: 1px solid rgba(201,151,58,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dim);
      text-decoration: none;
      transition: border-color 0.3s, color 0.3s;
    }

    .mobile-menu-socials a:hover {
      border-color: var(--gold);
      color: var(--gold-lt);
    }

    /* ============================================
       RESPONSIVE
    ============================================ */
    @media (max-width: 1024px) {
      nav { padding: 16px 24px; }
      nav.scrolled { padding: 12px 24px; }
      section { padding: 80px 28px; }
      #about { padding: 80px 28px; }
      #connect { padding: 80px 28px; }
      footer { padding: 50px 28px 30px; }
      .sermons-header { grid-template-columns: 1fr; gap: 20px; margin-bottom: 40px; }
      .books-grid { grid-template-columns: 1fr 1fr; }
      .footer-top { grid-template-columns: 1fr 1fr; gap: 36px; }
      .nav-links { display: none; }
      .hamburger { display: flex; }
    }

    @media (max-width: 768px) {
      .hero-content { padding: 0 24px; }
      .hero-verse { font-size: 16px; padding: 0 8px; }
      .hero-actions { flex-direction: column; align-items: center; gap: 12px; }
      .btn-primary, .btn-outline { padding: 14px 28px; font-size: 11px; width: 100%; max-width: 280px; text-align: center; }
      .scroll-indicator { display: none; }

      /* Sermon cards stack vertically */
      .sermon-card { grid-template-columns: 1fr; }
      .sermon-panel { width: 100%; min-height: 130px; flex-direction: row; align-items: center; gap: 18px; padding: 18px 20px; }
