                target="_blank">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2C6.484 2 2.004 6.48 2.004 12c0 1.937.538 3.73 1.47 5.258L2 22l4.86-1.447C8.328 21.463 10.123 22 12.004 22c5.52 0 10-4.48 10-10S17.524 2 12.004 2zm0 18.15c-1.705 0-3.296-.494-4.631-1.347l-.331-.2-3.435 1.022 1.018-3.36-.215-.343C3.457 14.85 2.967 13.48 2.967 12c0-4.98 4.057-9.033 9.037-9.033 4.98 0 9.034 4.053 9.034 9.033 0 4.98-4.054 9.15-9.034 9.15z"/></svg>
                WhatsApp
              </a>
              <a class="btn-book-fb"
