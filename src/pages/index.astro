<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Peter Milimo — Ministry & Leadership Platform</title>
  <meta name="description" content="Transforming lives through biblical truth, strong marriages, and practical empowerment. Peter Milimo Ministry — petermilimo.org" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* ============================================
       RESET & VARIABLES
    ============================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:         #1c2850;
      --navy-mid:     #243068;
      --navy-soft:    #2e3d88;
      --gold:         #b8842a;
      --gold-lt:      #d4a44c;
      --gold-pale:    #f0d9a8;
      --cream:        #fdfaf4;
      --white:        #ffffff;
      --slate:        #f2f5fc;
      --slate-mid:    #e6ecf7;
      --slate-dark:   #d8e2f5;
      --text-dark:    #141e3c;
      --text-mid:     #2d3d6e;
      --text-body:    #4a5a88;
      --text-dim:     #7a8cb0;
      --card-bg:      #ffffff;
      --card-border:  #e0e8f5;
      --gold-border:  rgba(184,132,42,0.22);
      --shadow-sm:    0 2px 12px rgba(28,40,80,0.08);
      --shadow-md:    0 8px 32px rgba(28,40,80,0.12);
      --shadow-lg:    0 20px 60px rgba(28,40,80,0.16);
      --shadow-gold:  0 8px 30px rgba(184,132,42,0.18);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Lato', sans-serif;
      background: var(--slate);
      color: var(--text-body);
      overflow-x: hidden;
    }

    /* ============================================
       NAVIGATION
    ============================================ */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 20px 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.4s ease, padding 0.4s ease, box-shadow 0.4s ease;
    }

    nav.scrolled {
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 14px 60px;
      box-shadow: 0 2px 24px rgba(28,40,80,0.1);
      border-bottom: 1px solid var(--card-border);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-mark { width: 40px; height: 40px; flex-shrink: 0; }
    .logo-mark svg { width: 100%; height: 100%; }

    .logo-text { display: flex; flex-direction: column; line-height: 1; }

    .logo-text .church-name {
      font-family: 'Cinzel', serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--white);
      text-transform: uppercase;
      transition: color 0.4s;
    }

    nav.scrolled .logo-text .church-name { color: var(--navy); }

    .logo-text .church-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 0.18em;
      color: rgba(255,255,255,0.65);
      text-transform: uppercase;
      margin-top: 3px;
      transition: color 0.4s;
    }

    nav.scrolled .logo-text .church-sub { color: var(--text-dim); }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      transition: color 0.3s;
      position: relative;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0; right: 0;
      height: 1px;
      background: var(--gold-lt);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s;
    }

    .nav-links a:hover::after { transform: scaleX(1); }

    nav.scrolled .nav-links a { color: var(--text-mid); }
    nav.scrolled .nav-links a:hover { color: var(--gold); }

    .nav-cta {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--white) !important;
      padding: 10px 22px;
      border-radius: 3px;
      text-decoration: none;
      transition: opacity 0.3s, transform 0.3s, box-shadow 0.3s !important;
      box-shadow: var(--shadow-gold);
    }

    .nav-cta::after { display: none !important; }
    .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 4px;
      padding: 9px 11px;
      width: 44px;
      height: 38px;
      position: relative;
      z-index: 200;
      transition: border-color 0.3s;
    }

    nav.scrolled .hamburger { border-color: var(--card-border); }
    .hamburger:hover { border-color: var(--gold-lt); }

    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--white);
      border-radius: 2px;
      transition: transform 0.35s ease, opacity 0.25s ease, background 0.4s;
      transform-origin: center;
    }

    nav.scrolled .hamburger span { background: var(--navy); }

    .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* ============================================
       MOBILE MENU
    ============================================ */
    .mobile-menu {
      position: fixed;
      inset: 0;
      background: rgba(20, 30, 70, 0.98);
      z-index: 150;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-menu.open { opacity: 1; pointer-events: all; }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .mobile-menu-nav a {
      font-family: 'Cinzel', serif;
      font-size: 20px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      padding: 18px 40px;
      width: 100%;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      opacity: 0;
      transform: translateY(14px);
      transition: color 0.3s, background 0.3s, opacity 0.4s ease, transform 0.4s ease;
    }

    .mobile-menu.open .mobile-menu-nav a { opacity: 1; transform: translateY(0); }
    .mobile-menu.open .mobile-menu-nav a:nth-child(1) { transition-delay: 0.04s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(2) { transition-delay: 0.09s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(3) { transition-delay: 0.14s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(4) { transition-delay: 0.19s; }
    .mobile-menu.open .mobile-menu-nav a:nth-child(5) { transition-delay: 0.24s; }
    .mobile-menu-nav a:hover { color: var(--gold-lt); background: rgba(255,255,255,0.04); }

    .mobile-menu-cta {
      margin-top: 32px;
      opacity: 0; transform: translateY(10px);
      transition: opacity 0.4s ease 0.28s, transform 0.4s ease 0.28s;
    }
    .mobile-menu.open .mobile-menu-cta { opacity: 1; transform: translateY(0); }
    .mobile-menu-cta a {
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--white);
      padding: 14px 44px;
      border-radius: 3px;
      text-decoration: none;
      display: inline-block;
    }

    /* ============================================
       HERO
    ============================================ */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(212,164,76,0.12) 0%, transparent 60%),
        radial-gradient(ellipse 50% 60% at 80% 80%, rgba(36,48,104,0.5) 0%, transparent 60%),
        linear-gradient(160deg, #0e1630 0%, #1c2850 35%, #243068 70%, #1a2248 100%);
    }

    /* light rays */
    .light-rays { position: absolute; inset: 0; pointer-events: none; }
    .light-ray {
      position: absolute; top: -10%; width: 2px; height: 130%;
      background: linear-gradient(180deg, rgba(212,164,76,0.22) 0%, rgba(212,164,76,0.04) 50%, transparent 100%);
      transform-origin: top center; border-radius: 2px;
    }
    .light-ray:nth-child(1) { left: 28%; transform: rotate(-10deg); opacity: 0.5; }
    .light-ray:nth-child(2) { left: 40%; transform: rotate(-4deg); opacity: 0.35; width: 3px; }
    .light-ray:nth-child(3) { left: 50%; width: 4px; opacity: 0.6; background: linear-gradient(180deg, rgba(212,164,76,0.3) 0%, rgba(212,164,76,0.06) 50%, transparent 100%); }
    .light-ray:nth-child(4) { left: 62%; transform: rotate(4deg); opacity: 0.35; width: 3px; }
    .light-ray:nth-child(5) { left: 74%; transform: rotate(10deg); opacity: 0.5; }

    /* orbs */
    .orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); }
    .orb-1 { width: 500px; height: 500px; top: -120px; left: 50%; transform: translateX(-50%); background: radial-gradient(circle, rgba(212,164,76,0.1) 0%, transparent 70%); animation: floatOrb 9s ease-in-out infinite; }
    .orb-2 { width: 280px; height: 280px; bottom: 8%; right: 8%; background: radial-gradient(circle, rgba(36,48,120,0.3) 0%, transparent 70%); animation: floatOrb 12s ease-in-out infinite reverse; }
    @keyframes floatOrb { 0%,100% { transform: translateY(0) translateX(-50%); } 50% { transform: translateY(-28px) translateX(-50%); } }

    /* cross watermark */
    .hero-cross {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -58%);
      opacity: 0.03; pointer-events: none;
    }
    .hero-cross svg { width: 600px; height: 600px; }

    .hero-content {
      position: relative; z-index: 2;
      text-align: center; padding: 0 20px;
      max-width: 900px;
    }

    .hero-eyebrow {
      font-family: 'Cinzel', serif;
      font-size: 10.5px; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--gold-lt);
      margin-bottom: 24px;
      opacity: 0; animation: fadeUp 1s ease forwards 0.3s;
      display: flex; align-items: center; justify-content: center; gap: 16px;
    }
    .hero-eyebrow::before, .hero-eyebrow::after {
      content: ''; display: block; width: 36px; height: 1px;
      background: var(--gold-lt); opacity: 0.5;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(48px, 7.5vw, 96px);
      font-weight: 300; line-height: 0.95;
      color: var(--white); letter-spacing: -0.01em;
      opacity: 0; animation: fadeUp 1.1s ease forwards 0.5s;
    }
    .hero-title em { font-style: italic; color: var(--gold-lt); }
    .hero-title .line2 { display: block; font-weight: 600; letter-spacing: 0.04em; }

    .hero-verse {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(17px, 2.4vw, 22px);
      font-weight: 300; font-style: italic;
      color: rgba(255,255,255,0.6);
      margin: 30px auto 10px; max-width: 600px; line-height: 1.75;
      opacity: 0; animation: fadeUp 1.1s ease forwards 0.75s;
    }

    .hero-ref {
      font-family: 'Cinzel', serif; font-size: 10px;
      letter-spacing: 0.22em; color: var(--gold-lt);
      opacity: 0; animation: fadeUp 1s ease forwards 0.95s;
    }

    .hero-actions {
      display: flex; align-items: center; justify-content: center;
      gap: 16px; margin-top: 48px; flex-wrap: wrap;
      opacity: 0; animation: fadeUp 1s ease forwards 1.15s;
    }

    .btn-primary {
      font-family: 'Cinzel', serif; font-size: 11.5px;
      letter-spacing: 0.13em; text-transform: uppercase; font-weight: 600;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--white); padding: 15px 36px; border-radius: 3px;
      text-decoration: none; border: none; cursor: pointer;
      transition: all 0.35s ease; box-shadow: var(--shadow-gold);
      position: relative; overflow: hidden; display: inline-block;
    }
    .btn-primary::before {
      content: ''; position: absolute; inset: 0;
      background: rgba(255,255,255,0.15);
      transform: translateX(-100%); transition: transform 0.4s;
    }
    .btn-primary:hover::before { transform: translateX(100%); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(184,132,42,0.4); }

    .btn-outline {
      font-family: 'Cinzel', serif; font-size: 11.5px;
      letter-spacing: 0.13em; text-transform: uppercase; font-weight: 400;
      color: rgba(255,255,255,0.85); padding: 14px 36px; border-radius: 3px;
      text-decoration: none; border: 1px solid rgba(255,255,255,0.3);
      cursor: pointer; background: transparent; transition: all 0.3s;
      display: inline-block;
    }
    .btn-outline:hover { border-color: var(--gold-lt); color: var(--gold-lt); transform: translateY(-2px); }

    .btn-outline-dark {
      font-family: 'Cinzel', serif; font-size: 11.5px;
      letter-spacing: 0.13em; text-transform: uppercase; font-weight: 400;
      color: var(--text-mid); padding: 13px 28px; border-radius: 3px;
      text-decoration: none; border: 1px solid var(--card-border);
      cursor: pointer; background: transparent; transition: all 0.3s;
      display: inline-block;
    }
    .btn-outline-dark:hover { border-color: var(--gold); color: var(--gold); }

    .scroll-indicator {
      position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      cursor: pointer;
      opacity: 0; animation: fadeUp 1s ease forwards 1.5s;
    }
    .scroll-indicator span { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
    .scroll-line { width: 1px; height: 48px; background: linear-gradient(180deg, var(--gold-lt) 0%, transparent 100%); animation: scrollPulse 2s ease-in-out infinite; }
    @keyframes scrollPulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }

    /* ============================================
       SHARED SECTION STYLES
    ============================================ */
    .section-wrap { padding: 100px 60px; max-width: 1280px; margin: 0 auto; }
    .section-bg-white { background: var(--white); }
    .section-bg-slate  { background: var(--slate); }
    .section-bg-alt    { background: var(--slate-mid); }
    .section-bg-navy   { background: var(--navy); }

    .section-eyebrow {
      font-family: 'Cinzel', serif; font-size: 10px;
      letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 14px;
      display: flex; align-items: center; gap: 14px;
    }
    .section-eyebrow::before { content: ''; display: block; width: 28px; height: 1px; background: var(--gold); opacity: 0.6; }
    .section-eyebrow.center { justify-content: center; padding-left: 42px; }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(32px, 4vw, 54px);
      font-weight: 300; color: var(--text-dark);
      line-height: 1.1; letter-spacing: -0.01em; margin-bottom: 16px;
    }
    .section-title em { font-style: italic; color: var(--gold); }
    .section-title.light { color: var(--white); }
    .section-title.light em { color: var(--gold-lt); }

    .section-subtitle {
      font-size: 16px; font-weight: 300;
      color: var(--text-body); line-height: 1.85; max-width: 520px;
    }

    /* ============================================
       INTRO / PILLARS
    ============================================ */
    .intro-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 72px; align-items: center;
    }
    .intro-left .section-subtitle { max-width: 100%; font-size: 16.5px; margin-bottom: 18px; }
    .intro-right { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .pillar-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 8px; padding: 28px 22px;
      transition: border-color 0.35s, transform 0.35s, box-shadow 0.35s;
      position: relative; overflow: hidden;
    }
    .pillar-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      transform: scaleX(0); transform-origin: left; transition: transform 0.4s;
    }
    .pillar-card:hover::before { transform: scaleX(1); }
    .pillar-card:hover { border-color: var(--gold-border); transform: translateY(-4px); box-shadow: var(--shadow-md); }

    .pillar-icon { font-size: 30px; margin-bottom: 14px; display: block; }
    .pillar-title { font-family: 'Cinzel', serif; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); margin-bottom: 8px; line-height: 1.3; }
    .pillar-desc { font-size: 13px; font-weight: 300; color: var(--text-body); line-height: 1.65; }

    /* ============================================
       SERMONS
    ============================================ */
    .sermons-header {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 40px; align-items: end; margin-bottom: 56px;
    }

    .sermons-grid { display: flex; flex-direction: column; gap: 20px; }

    .sermon-card {
      display: grid; grid-template-columns: 240px 1fr;
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; overflow: hidden;
      transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
      cursor: pointer; position: relative;
    }
    .sermon-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      transform: scaleX(0); transform-origin: left; transition: transform 0.45s; z-index: 2;
    }
    .sermon-card:hover::before { transform: scaleX(1); }
    .sermon-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--gold-border); }

    .sermon-panel {
      position: relative; overflow: hidden; min-height: 200px;
      display: flex; flex-direction: column; justify-content: flex-end; padding: 24px;
      width: 240px; flex-shrink: 0;
    }
    .sermon-panel-bg { position: absolute; inset: 0; }
    .sermon-panel-bg-1 { background: linear-gradient(140deg, #081532 0%, #102260 55%, #1a3a90 100%); }
    .sermon-panel-bg-2 { background: linear-gradient(140deg, #120820 0%, #241040 55%, #3d1a6e 100%); }
    .sermon-panel-bg-3 { background: linear-gradient(140deg, #071a10 0%, #0c3020 55%, #144d30 100%); }

    .sermon-panel-cross {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -55%); opacity: 0.07; pointer-events: none;
    }
    .sermon-waveform {
      position: absolute; bottom: 0; left: 0; right: 0; height: 52px;
      display: flex; align-items: flex-end; gap: 3px; padding: 0 24px; opacity: 0.2;
    }
    .sermon-waveform span { display: block; flex: 1; border-radius: 2px 2px 0 0; background: var(--gold-lt); }

    .sermon-play {
      position: relative; z-index: 2; width: 50px; height: 50px; border-radius: 50%;
      border: 1.5px solid rgba(212,164,76,0.55);
      background: rgba(212,164,76,0.12);
      display: flex; align-items: center; justify-content: center;
      transition: all 0.35s; margin-bottom: 14px; flex-shrink: 0;
    }
    .sermon-card:hover .sermon-play { background: var(--gold-lt); border-color: var(--gold-lt); }
    .sermon-play svg { width: 16px; height: 16px; fill: var(--gold-lt); margin-left: 3px; transition: fill 0.3s; }
    .sermon-card:hover .sermon-play svg { fill: var(--navy); }

    .sermon-panel-tag { position: relative; z-index: 2; font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-lt); opacity: 0.9; }
    .sermon-panel-verse { position: relative; z-index: 2; font-family: 'Cormorant Garamond', serif; font-size: 13px; font-style: italic; font-weight: 300; color: rgba(255,255,255,0.42); line-height: 1.5; margin-top: 8px; max-width: 180px; }

    .sermon-body { padding: 28px; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
    .sermon-body-top { flex: 1; }

    .sermon-date { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; margin-bottom: 10px; }
    .sermon-title { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 600; color: var(--text-dark); line-height: 1.2; margin-bottom: 10px; }
    .sermon-speaker { font-size: 13px; color: var(--text-dim); font-weight: 300; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .sermon-speaker::before { content: ''; display: inline-block; width: 18px; height: 1px; background: var(--text-dim); opacity: 0.5; flex-shrink: 0; }
    .sermon-excerpt { font-size: 14px; font-weight: 300; color: var(--text-body); line-height: 1.75; margin-bottom: 22px; }

    .sermon-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

    .btn-sm {
      font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 9px 18px; border-radius: 3px;
      text-decoration: none; cursor: pointer; border: none;
      transition: all 0.3s; display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-sm-gold { background: rgba(184,132,42,0.1); color: var(--gold); border: 1px solid rgba(184,132,42,0.28); }
    .btn-sm-gold:hover { background: rgba(184,132,42,0.18); border-color: var(--gold); }
    .btn-sm-fb { background: rgba(24,119,242,0.08); color: #1877f2; border: 1px solid rgba(24,119,242,0.22); }
    .btn-sm-fb:hover { background: rgba(24,119,242,0.16); border-color: rgba(24,119,242,0.45); }
    .sermon-duration { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.12em; color: var(--text-dim); margin-left: auto; }

    /* ============================================
       BOOKS
    ============================================ */
    .books-header { display: grid; grid-template-columns: 1fr auto; align-items: end; margin-bottom: 56px; gap: 40px; }
    .books-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }

    .book-card {
      border-radius: 10px; overflow: hidden;
      transition: transform 0.45s ease, box-shadow 0.45s ease;
      background: var(--card-bg); border: 1px solid var(--card-border);
      display: flex; flex-direction: column;
    }
    .book-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }

    .book-cover { position: relative; height: 280px; overflow: hidden; }
    .book-cover-bg { position: absolute; inset: 0; transition: transform 0.55s ease; }
    .book-card:hover .book-cover-bg { transform: scale(1.04); will-change: transform; }
    .book-cover-bg-1 { background: linear-gradient(160deg, #071228 0%, #0f2260 40%, #1a3a90 100%); }
    .book-cover-bg-2 { background: linear-gradient(160deg, #160508 0%, #3a1015 40%, #6e2020 100%); }
    .book-cover-bg-3 { background: linear-gradient(160deg, #03100a 0%, #0c2e18 40%, #155530 100%); }

    .book-spine { position: absolute; top: 0; left: 0; bottom: 0; width: 6px; }
    .book-spine-1 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }
    .book-spine-2 { background: linear-gradient(180deg, #f5e0c0, var(--gold-lt)); }
    .book-spine-3 { background: linear-gradient(180deg, var(--gold-lt), var(--gold)); }

    .book-cover-ornament   { position: absolute; left: 20px; right: 20px; top: 20px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,164,76,0.4), transparent); }
    .book-cover-ornament-b { position: absolute; left: 20px; right: 20px; bottom: 20px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212,164,76,0.4), transparent); }
    .book-cover-cross { position: absolute; top: 24px; right: 24px; opacity: 0.1; }

    .book-price-badge {
      position: absolute; top: 18px; left: 18px;
      background: rgba(184,132,42,0.18); border: 1px solid rgba(212,164,76,0.4);
      border-radius: 3px; padding: 5px 12px;
      font-family: 'Cormorant Garamond', serif; font-size: 15px; font-weight: 600;
      color: var(--gold-lt); backdrop-filter: blur(8px);
    }

    .book-cover-content {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 28px 24px 26px 30px;
    }
    .book-cover-category { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold-lt); margin-bottom: 10px; }
    .book-cover-title { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 700; color: var(--white); line-height: 1.15; margin-bottom: 6px; }
    .book-cover-author { font-size: 12px; font-weight: 300; color: rgba(255,255,255,0.48); letter-spacing: 0.1em; }

    .book-body { padding: 22px 22px 22px; display: flex; flex-direction: column; gap: 16px; flex: 1; }
    .book-desc { font-size: 13.5px; color: var(--text-body); line-height: 1.75; font-weight: 300; flex: 1; }

    .book-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .btn-book-pay {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 14px; border-radius: 3px;
      font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.1em;
      text-transform: uppercase; text-decoration: none; cursor: pointer;
      transition: all 0.3s; border: 1px solid;
    }
    .btn-book-pay-gold { background: linear-gradient(135deg, var(--gold-lt), var(--gold)); color: var(--white); border-color: var(--gold); box-shadow: var(--shadow-gold); }
    .btn-book-pay-gold:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-book-pay-outline { background: transparent; color: var(--text-mid); border-color: var(--card-border); }
    .btn-book-pay-outline:hover { border-color: var(--gold); color: var(--gold); }

    /* ============================================
       YOUTUBE SECTION
    ============================================ */
    .yt-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .yt-channel-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.4s, box-shadow 0.4s, border-color 0.4s;
      display: flex;
      flex-direction: column;
    }
    .yt-channel-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(255,0,0,0.18);
    }

    /* Red top bar */
    .yt-channel-card::before {
      content: '';
      display: block;
      height: 4px;
      background: linear-gradient(90deg, #ff0000, #cc0000);
    }

    .yt-card-header {
      padding: 28px 28px 20px;
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .yt-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cinzel', serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--white);
      flex-shrink: 0;
      border: 2px solid rgba(255,255,255,0.3);
    }
    .yt-avatar-1 { background: linear-gradient(135deg, #1c2850, #2e3d88); }
    .yt-avatar-2 { background: linear-gradient(135deg, #6e1a1a, #cc2020); }

    .yt-channel-meta { flex: 1; min-width: 0; }
    .yt-channel-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 700;
      color: var(--text-dark);
      line-height: 1.2;
      margin-bottom: 4px;
    }
    .yt-channel-handle {
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    .yt-card-desc {
      padding: 0 28px 20px;
      font-size: 14px;
      font-weight: 300;
      color: var(--text-body);
      line-height: 1.75;
      flex: 1;
    }

    /* Latest videos preview strip */
    .yt-latest-label {
      margin: 0 28px 12px;
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
    }

    .yt-video-list {
      margin: 0 28px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 24px;
    }

    .yt-video-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      background: var(--slate);
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.25s;
      border: 1px solid var(--card-border);
    }
    .yt-video-item:hover { background: var(--slate-mid); }

    .yt-play-dot {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #ff0000;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .yt-play-dot svg { width: 11px; height: 11px; fill: white; margin-left: 2px; }

    .yt-video-title {
      font-size: 13px;
      font-weight: 400;
      color: var(--text-dark);
      line-height: 1.4;
      flex: 1;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .yt-card-footer {
      padding: 18px 28px;
      border-top: 1px solid var(--card-border);
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .btn-yt {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 6px;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      cursor: pointer;
      border: none;
    }
    .btn-yt-red {
      background: #ff0000;
      color: var(--white);
    }
    .btn-yt-red:hover { background: #cc0000; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(255,0,0,0.3); }

    .btn-yt-outline {
      background: transparent;
      color: var(--text-mid);
      border: 1px solid var(--card-border);
    }
    .btn-yt-outline:hover { border-color: var(--gold); color: var(--gold); }

    .yt-sub-count {
      margin-left: auto;
      font-family: 'Cinzel', serif;
      font-size: 10px;
      letter-spacing: 0.1em;
      color: var(--text-dim);
    }

    /* ============================================
       PAYMENT SECTION — AGGREGATOR + PAYPAL
    ============================================ */
    .payment-section-inner {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
    }

    .payment-tabs {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin: 36px 0 44px;
      flex-wrap: wrap;
    }
    .tab-btn {
      font-family: 'Cinzel', serif;
      font-size: 10.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      padding: 10px 24px;
      border-radius: 30px;
      border: 1px solid var(--card-border);
      background: var(--white);
      color: var(--text-body);
      cursor: pointer;
      transition: all 0.3s;
    }
    .tab-btn:hover, .tab-btn.active {
      background: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .payment-panel { display: none; text-align: left; }
    .payment-panel.active { display: block; }

    /* Two-column layout: aggregator | paypal */
    .pay-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: start;
    }

    .pay-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      transition: box-shadow 0.3s;
    }
    .pay-card:hover { box-shadow: var(--shadow-md); }

    .pay-card-header {
      padding: 24px 24px 18px;
      border-bottom: 1px solid var(--card-border);
    }
    .pay-card-title {
      font-family: 'Cinzel', serif;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--text-dark);
      margin-bottom: 6px;
    }
    .pay-card-subtitle {
      font-size: 13px;
      font-weight: 300;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* Accepted methods badges */
    .pay-methods-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }
    .pay-badge {
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.05em;
      border: 1px solid;
    }
    .pay-badge-mpesa   { background:#e8f7ef; color:#00a550; border-color:#b3e5cc; }
    .pay-badge-airtel  { background:#fdecea; color:#e4002b; border-color:#f5b8c0; }
    .pay-badge-visa    { background:#eef0f9; color:#1a1f71; border-color:#c0c5e8; }
    .pay-badge-mc      { background:#fff5ec; color:#eb6100; border-color:#f5cfb0; }

    .pay-card-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 12px; }

    .pay-input {
      width: 100%;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid var(--card-border);
      background: var(--slate);
      font-family: 'Lato', sans-serif;
      font-size: 15px;
      color: var(--text-dark);
      outline: none;
      transition: border-color 0.3s, background 0.3s;
    }
    .pay-input:focus { border-color: var(--gold); background: var(--white); }

    .pay-input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .pay-label {
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 4px;
      display: block;
    }
    .pay-field { display: flex; flex-direction: column; }

    .pay-submit {
      width: 100%;
      padding: 14px;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--gold-lt), var(--gold));
      color: var(--white);
      font-family: 'Cinzel', serif;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: var(--shadow-gold);
      margin-top: 4px;
    }
    .pay-submit:hover { opacity: 0.88; transform: translateY(-1px); }
    .pay-submit-pp {
      background: linear-gradient(135deg, #009cde, #003087);
      box-shadow: 0 8px 24px rgba(0,48,135,0.25);
    }

    .pay-secure-note {
      text-align: center;
      font-size: 11.5px;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding-top: 4px;
    }

    /* PayPal divider */
    .pp-or {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 12px;
      color: var(--text-dim);
      margin: 4px 0;
    }
    .pp-or::before, .pp-or::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--card-border);
    }

    /* Donation presets */
    .amt-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .amt-btn {
      font-family: 'Cinzel', serif;
      font-size: 11.5px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 6px;
      border: 1px solid var(--card-border);
      background: var(--white);
      color: var(--text-mid);
      cursor: pointer;
      transition: all 0.25s;
      letter-spacing: 0.04em;
    }
    .amt-btn:hover, .amt-btn.selected {
      background: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .pay-notice {
      background: var(--slate);
      border: 1px solid var(--card-border);
      border-left: 3px solid var(--gold);
      border-radius: 6px;
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 300;
      color: var(--text-body);
      line-height: 1.65;
    }

    @media (max-width: 700px) {
      .pay-two-col { grid-template-columns: 1fr; }
      .yt-grid { grid-template-columns: 1fr; }
    }

    /* ============================================
       RESOURCES (PDF)
    ============================================ */
    .resources-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

    .resource-card {
      background: var(--card-bg); border: 1px solid var(--card-border);
      border-radius: 10px; padding: 28px 24px;
      transition: transform 0.35s, box-shadow 0.35s, border-color 0.35s;
      display: flex; flex-direction: column; gap: 14px;
      position: relative; overflow: hidden;
    }
    .resource-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      transform: scaleX(0); transform-origin: left; transition: transform 0.4s;
    }
    .resource-card:hover::before { transform: scaleX(1); }
    .resource-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--gold-border); }

    .resource-icon {
      width: 52px; height: 52px; border-radius: 10px;
      background: linear-gradient(135deg, #fff0d8, #fce4b0);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .resource-icon svg { width: 26px; height: 26px; }

    .resource-tag { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
    .resource-title { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 600; color: var(--text-dark); line-height: 1.25; }
    .resource-desc { font-size: 13.5px; color: var(--text-body); font-weight: 300; line-height: 1.7; flex: 1; }
    .resource-meta { font-size: 12px; color: var(--text-dim); font-weight: 300; display: flex; align-items: center; gap: 10px; }
    .resource-meta span { display: flex; align-items: center; gap: 4px; }

    .btn-download {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 11px 18px; border-radius: 6px;
      background: rgba(184,132,42,0.08); border: 1px solid rgba(184,132,42,0.25);
      color: var(--gold); font-family: 'Cinzel', serif; font-size: 10px;
      letter-spacing: 0.12em; text-transform: uppercase;
      text-decoration: none; cursor: pointer; transition: all 0.3s; font-weight: 600;
    }
    .btn-download:hover { background: var(--gold); color: var(--white); border-color: var(--gold); }

    /* ============================================
       ABOUT / STATS
    ============================================ */
    .verse-block { max-width: 780px; margin: 0 auto; text-align: center; margin-bottom: 64px; }
    .verse-quote {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(24px, 3.2vw, 42px); font-weight: 300; font-style: italic;
      color: var(--white); line-height: 1.55; margin-bottom: 22px;
      position: relative;
    }
    .verse-quote::before {
      content: '\201C'; position: absolute; top: -30px; left: 50%; transform: translateX(-50%);
      font-size: 90px; color: var(--gold-lt); opacity: 0.15;
      font-family: 'Cormorant Garamond', serif; line-height: 1;
    }
    .verse-ref { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 0.2em; color: var(--gold-lt); text-transform: uppercase; }

    .about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; max-width: 860px; margin: 0 auto; }
    .about-stat { padding: 48px 36px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); text-align: center; }
    .stat-number { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: var(--gold-lt); line-height: 1; margin-bottom: 8px; }
    .stat-label { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); }

    /* ============================================
       CONNECT (Facebook only)
    ============================================ */
    .connect-inner { max-width: 1280px; margin: 0 auto; }
    .connect-header { text-align: center; margin-bottom: 56px; }

    .connect-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 820px; margin: 0 auto; }

    .connect-card {
      border-radius: 10px; padding: 46px 40px;
      display: flex; flex-direction: column; align-items: flex-start;
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      text-decoration: none; cursor: pointer; position: relative; overflow: hidden;
    }
    .connect-card:hover { transform: translateY(-5px); }

    .connect-card-fb {
      background: linear-gradient(135deg, #0a1432 0%, #0d1e4a 100%);
      border: 1px solid rgba(24,119,242,0.22);
    }
    .connect-card-fb:hover { box-shadow: 0 20px 60px rgba(24,119,242,0.18); border-color: rgba(24,119,242,0.45); }

    .connect-card-email {
      background: linear-gradient(135deg, #1a0e06 0%, #2d1a0a 100%);
      border: 1px solid rgba(184,132,42,0.22);
    }
    .connect-card-email:hover { box-shadow: 0 20px 60px rgba(184,132,42,0.15); border-color: rgba(184,132,42,0.45); }

    .connect-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 22px; }
    .connect-icon-fb    { background: rgba(24,119,242,0.15); }
    .connect-icon-email { background: rgba(184,132,42,0.15); }

    .connect-card-title { font-family: 'Cinzel', serif; font-size: 17px; font-weight: 600; color: var(--white); margin-bottom: 10px; }
    .connect-card-desc  { font-size: 14px; font-weight: 300; color: rgba(255,255,255,0.55); line-height: 1.75; margin-bottom: 28px; flex: 1; }

    .connect-link-text {
      font-family: 'Cinzel', serif; font-size: 10.5px; letter-spacing: 0.14em;
      text-transform: uppercase; display: flex; align-items: center; gap: 10px;
    }
    .connect-card-fb .connect-link-text    { color: #6ba8f7; }
    .connect-card-email .connect-link-text { color: var(--gold-lt); }
    .connect-link-text::after { content: '→'; transition: transform 0.3s; }
    .connect-card:hover .connect-link-text::after { transform: translateX(6px); }

    /* ============================================
       FOOTER
    ============================================ */
    footer { background: var(--navy); border-top: 1px solid rgba(255,255,255,0.06); padding: 64px 60px 36px; }
    .footer-inner { max-width: 1280px; margin: 0 auto; }

    .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 52px; }
    .footer-brand p { font-size: 14px; font-weight: 300; color: rgba(255,255,255,0.45); line-height: 1.8; margin-top: 18px; max-width: 260px; }

    .footer-col-title { font-family: 'Cinzel', serif; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-lt); margin-bottom: 18px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col ul a { font-size: 14px; font-weight: 300; color: rgba(255,255,255,0.45); text-decoration: none; transition: color 0.3s; }
    .footer-col ul a:hover { color: var(--gold-lt); }

    .footer-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 26px; border-top: 1px solid rgba(255,255,255,0.06); }
    .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.3); font-weight: 300; }

    .footer-social { display: flex; gap: 14px; }
    .footer-social a {
      width: 34px; height: 34px; border-radius: 3px;
      border: 1px solid rgba(255,255,255,0.12);
      display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.4); text-decoration: none; transition: all 0.3s;
    }
    .footer-social a:hover { border-color: var(--gold-lt); color: var(--gold-lt); }

    /* ============================================
       SCROLL REVEAL
    ============================================ */
    .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.8s ease, transform 0.8s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }

    /* ============================================
       RESPONSIVE
    ============================================ */
    @media (max-width: 1024px) {
      nav { padding: 16px 24px; }
      nav.scrolled { padding: 12px 24px; }
      .section-wrap { padding: 80px 28px; }
      footer { padding: 52px 28px 30px; }
      .sermons-header { grid-template-columns: 1fr; gap: 20px; margin-bottom: 40px; }
      .books-grid { grid-template-columns: 1fr 1fr; }
      .resources-grid { grid-template-columns: 1fr 1fr; }
      .footer-top { grid-template-columns: 1fr 1fr; gap: 36px; }
      .nav-links { display: none; }
      .hamburger { display: flex; }
    }

    @media (max-width: 768px) {
      .section-wrap { padding: 60px 20px; }
      footer { padding: 44px 20px 24px; }
      nav { padding: 14px 20px; }

      .hero-verse { font-size: 16px; padding: 0 8px; }
      .hero-actions { flex-direction: column; align-items: center; gap: 12px; }
      .btn-primary, .btn-outline { padding: 14px 28px; width: 100%; max-width: 280px; text-align: center; }
      .scroll-indicator { display: none; }

      .sermon-card { grid-template-columns: 1fr; }
      .sermon-panel { width: 100%; min-height: 120px; flex-direction: row; align-items: center; gap: 16px; padding: 18px 20px; }
      .sermon-play { margin-bottom: 0; flex-shrink: 0; }
      .sermon-panel-verse, .sermon-panel-cross, .sermon-waveform { display: none; }
      .sermon-body { padding: 18px 20px 20px; }
      .sermon-title { font-size: 20px; }
      .sermon-excerpt { font-size: 13px; margin-bottom: 16px; }
      .sermon-duration { display: none; }

      .books-grid { grid-template-columns: 1fr; }
      .books-header { grid-template-columns: 1fr; }
      .book-cover { height: 220px; }

      .payment-grid { grid-template-columns: 1fr; }

      .resources-grid { grid-template-columns: 1fr; }

      .intro-grid { grid-template-columns: 1fr; gap: 40px; }
      .intro-right { grid-template-columns: 1fr 1fr; }

      .about-grid { grid-template-columns: 1fr; gap: 2px; }
      .about-stat { padding: 32px 20px; }

      .connect-cards { grid-template-columns: 1fr; max-width: 480px; }
      .connect-card { padding: 32px 24px; }

      .footer-top { grid-template-columns: 1fr; gap: 28px; }
      .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }

      .donation-amounts { gap: 8px; }
      .amt-btn { padding: 9px 16px; font-size: 11px; }
    }

    @media (max-width: 480px) {
      .intro-right { grid-template-columns: 1fr; }
      .book-actions { grid-template-columns: 1fr; }
      .logo-text .church-sub { display: none; }
      .pillar-card { padding: 20px 16px; }
      .sermon-panel { min-height: 100px; }
    }
  </style>
</head>
