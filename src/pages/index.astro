          <a href="${r.url}" class="btn-dl" download>${dlSvg} Download PDF</a>
        </div>
      `).join('');
      observeReveals();
    }

    /* ======================================================
       PAYMENT
    ====================================================== */
    function switchTab(id, btn) {
      document.querySelectorAll('.pay-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('panel-' + id).classList.add('active');
      btn.classList.add('active');
    }
    function switchTabByName(id) {
      const btn = document.querySelector(`.tab-btn[onclick*="${id}"]`);
      if (btn) switchTab(id, btn);
    }
    function selectAmt(btn, group, val) {
      document.querySelectorAll(`#amt-${group} .amt-btn`).forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      const inp = document.getElementById(`${group}-amount`);
      if (inp && val) inp.value = val;
    }
    function updateBookTotal() {
      const sel = document.getElementById('book-select');
      const qty = parseInt(document.getElementById('book-qty').value) || 1;
      const box = document.getElementById('book-total-box');
      const txt = document.getElementById('book-total-text');
      if (!sel || !sel.value) { if (box) box.style.display = 'none'; return; }
      const price = parseInt(sel.value);
      const total = price * qty;
      if (txt) txt.textContent = `Order Total: KSh ${total.toLocaleString()} (${qty} × KSh ${price.toLocaleString()})`;
      if (box) box.style.display = 'block';
    }
    function handlePay(method) {
      alert(
        `Payment gateway ready to connect.\n\nFlow: "${method}"\n\n` +
        `Aggregator → replace with Pesapal / Flutterwave / Paystack SDK.\n` +
        `PayPal → replace with PayPal JS SDK or PayPal.me redirect.`
      );
    }

    /* ======================================================
       NAV SCROLL
    ====================================================== */
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 60);
    });

    /* ======================================================
       MOBILE MENU
    ====================================================== */
    var _menu  = document.getElementById('mobileMenu');
    var _bd    = document.getElementById('mmBackdrop');
    var _hbg   = document.getElementById('hamburger');
    var _close = document.getElementById('mmClose');

    function closeMobileMenu() {
      _menu.classList.remove('open');
      _bd.classList.remove('open');
      _hbg.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function openMobileMenu() {
      _menu.classList.add('open');
      _bd.classList.add('open');
      _hbg.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    _hbg.addEventListener('click', function () {
      _menu.classList.contains('open') ? closeMobileMenu() : openMobileMenu();
    });

    _close.addEventListener('click', closeMobileMenu);
    _bd.addEventListener('click', closeMobileMenu);

    /* Close when any nav link is clicked */
    document.querySelectorAll('.mm-nav a').forEach(function (a) {
      a.addEventListener('click', closeMobileMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMobileMenu();
    });

    /* ======================================================
       SCROLL REVEAL
    ====================================================== */
    const revealObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });

    function observeReveals() {
      document.querySelectorAll('.reveal:not([data-obs])').forEach(el => {
        el.setAttribute('data-obs', '1');
        revealObs.observe(el);
      });
    }

    /* ======================================================
       INIT
    ====================================================== */
    renderSermons();
    renderBooks();
    renderResources();
    observeReveals();

